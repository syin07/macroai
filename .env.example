# Copy to .env.local and fill in (./setup.sh does the copy). Never commit real values.
# Only NEXT_PUBLIC_* variables may be used in client code; everything else is server-only.

# --- Supabase ---------------------------------------------------------------
# Local: `supabase start` prints these. Hosted: Project Settings → API (macroai-dev for local/preview).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth for the local Supabase stack only: supabase/config.toml reads these via env(),
# so export them in your shell (or put them in the gitignored supabase/.env) before `supabase start`.
# Hosted projects set Google credentials in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Access -------------------------------------------------------------------
# Comma-separated; also seeded into the approved_emails table.
APPROVED_EMAILS=

# --- AI -------------------------------------------------------------------------
# gemini | anthropic | openai. Final choice comes from the model bake-off (docs/bakeoff-results.md).
AI_PROVIDER=
# Only the selected provider's key is needed in production; the bake-off needs all three.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Max model calls per user per day before /api/ai/chat returns 429 ai_cap_reached.
AI_DAILY_CALL_CAP=150

# --- Nutrition data -------------------------------------------------------------
# Free key from https://api.data.gov/signup/
USDA_API_KEY=

# --- Frontend -------------------------------------------------------------------
# 1 = the UI uses fixtures from src/mocks instead of the API.
NEXT_PUBLIC_USE_MOCKS=0
